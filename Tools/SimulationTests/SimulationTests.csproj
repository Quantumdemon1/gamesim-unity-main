<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The simulation's own tests, run WITHOUT Unity.

    Gamesim.Simulation is noEngineReferences: pure C# with nothing but System underneath it. So
    are the tests listed below. That makes them runnable on a stock CI runner with no editor and
    no licence, which is the only way anything in this repository gets tested on a push until
    somebody adds the Unity secrets (see the note at the bottom of .github/workflows/ci.yml).

    This is a SUBSET of Gamesim.EditModeTests, not a replacement for it. The editor run is still
    the suite. What this buys is that a change to the rules, the seeded stream or a web parity
    fixture cannot reach main having never been executed by anything.

    Two things are pinned to what Unity does, so a pass here means what a pass there means:
      - LangVersion 9, Unity 6's compiler. Newer syntax would build here and break the editor.
      - No implicit usings. A file that forgot `using System.Linq;` must fail here as it does there.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0414;CS0169;NUnit2005;NUnit2007</NoWarn>
    <RootDir>$(MSBuildThisFileDirectory)../../</RootDir>
    <Simulation>$(RootDir)Assets/Gamesim/Simulation/</Simulation>
    <EditMode>$(RootDir)Assets/Gamesim/Tests/EditMode/</EditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole assembly, exactly as Unity compiles it. -->
    <Compile Include="$(Simulation)**/*.cs" />

    <!--
      Tests that touch nothing but System, NUnit, Newtonsoft and Gamesim.Simulation. Nothing of
      Unity's is stubbed: the web parity tests find their fixtures through Application.dataPath
      only under UNITY_EDITOR, and beside the binary otherwise. Tests that parse through
      JsonUtility or growing Gamesim.Persistence owners are deliberately NOT here - standing
      Newtonsoft in for JsonUtility would change what is being tested. The narrow fixed JSON
