# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE and editor state
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Third-party asset packs are re-installable dependencies, not source.
# UMA 3 is roughly a gigabyte; committing it would bloat every clone, and GitHub
# hard-rejects any single file over 100MB, which a pack this size can easily contain.
# Re-import from Package Manager > My Assets rather than from source control.
[Aa]ssets/UMA/
[Aa]ssets/UMA.meta
[Aa]ssets/UMA_Assets/
[Aa]ssets/UMA_Assets.meta

# UMA's preferred project index registers source-owned clothing. Keep that override and its
# GUIDs portable while leaving generated tasks, tests and other local library data untracked.
Assets/UMAProjectData/*
!Assets/UMAProjectData/Resources/
!Assets/UMAProjectData/Resources.meta
Assets/UMAProjectData/Resources/*
!Assets/UMAProjectData/Resources/AssetIndexerProject.asset
!Assets/UMAProjectData/Resources/AssetIndexerProject.asset.meta

# Unity's crash-recovery scenes and the test runner's bootstrap scene, which a run that is cut
# short leaves behind. Neither is project source.
[Aa]ssets/_Recovery/
[Aa]ssets/_Recovery.meta
[Aa]ssets/InitTestScene*.unity
[Aa]ssets/InitTestScene*.unity.meta

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Unity crash and test output
sysinfo.txt
test-results.xml

# Local service configuration and credentials must not enter source control.
.env
.env.*
!.env.example

# Icon contact sheet from Gamesim > U07 > Preview HUD icons. A review aid for artwork that is
# white-on-transparent and therefore invisible in most viewers; regenerate it, do not track it.
icon-preview.png

# Python bytecode from the Blender-side tools
__pycache__/
*.pyc

# Poly Haven downloads are a cache; the asset id in each bb_set_ph_*.py is the source of record.
ArtSource/polyhaven/

# Claude Code session state, including the agents worktrees.
.claude/

# The Unity-free simulation test project is source even though every other .csproj here is
# regenerated by the editor; its build output is not.
!Tools/SimulationTests/SimulationTests.csproj
Tools/SimulationTests/bin/
